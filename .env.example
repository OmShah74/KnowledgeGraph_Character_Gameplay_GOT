# Copy to .env and adjust. Docker Compose reads this file automatically.

# Neo4j credentials (password must be at least 8 characters)
NEO4J_PASSWORD=westeros-graph

# Optional: fixed Fernet key used to encrypt stored API keys.
# If unset, one is generated on first run and stored in the backend storage volume.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOT_SECRET_KEY=

# Where the browser reaches the backend (baked into the frontend at build time)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Comma-separated origins allowed to call the backend
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
